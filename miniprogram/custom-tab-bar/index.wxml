<view class="tabbar">
  <view
    wx:for="{{tabs}}"
    wx:key="path"
    class="tabbar__item {{selected === index ? 'tabbar__item--active' : ''}}"
    data-index="{{index}}"
    bindtap="onTab"
  >
    <view class="tabbar__icon">{{item.icon}}</view>
    <view class="tabbar__text">{{item.text}}</view>
  </view>
</view>