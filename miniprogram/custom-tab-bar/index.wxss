.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 60;
  display: flex;
  align-items: center;
  height: 112rpx;
  padding-bottom: env(safe-area-inset-bottom);
  background: var(--glass-bg);
  border-top: 1rpx solid var(--border);
  backdrop-filter: blur(30rpx) saturate(1.6);
  -webkit-backdrop-filter: blur(30rpx) saturate(1.6);
}

.tabbar__item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  color: var(--text-2);
  transition: transform 0.18s cubic-bezier(0.32, 0.72, 0, 1);
}

.tabbar__item--active {
  color: var(--accent);
  transform: scale(1.06);
}

.tabbar__item:active {
  transform: scale(0.94);
}

.tabbar__icon {
  font-size: 38rpx;
  line-height: 1;
}

.tabbar__text {
  font-size: 21rpx;
}