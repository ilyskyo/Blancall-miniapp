/* 素材库样式（颜色一律走 CSS 变量） */

.subhead {
  display: flex;
  align-items: center;
  gap: 12rpx;
  height: 88rpx;
  margin-bottom: 12rpx;
}

.subhead__back {
  width: 64rpx;
  text-align: center;
  font-size: 52rpx;
  line-height: 1;
  color: var(--text);
}

.subhead__title {
  flex: 1;
  min-width: 0;
  font-size: 34rpx;
  font-weight: 600;
}

.subhead__spacer {
  width: 120rpx;
}

.hint-card {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  align-items: flex-start;
  margin-bottom: 24rpx;
}

.lib-card {
  margin-bottom: 24rpx;
}

.lib-desc {
  margin-top: 8rpx;
}

.lib-actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 24rpx;
}

.lib-item-left {
  gap: 20rpx;
  min-width: 0;
}

.lib-no {
  width: 56rpx;
  text-align: right;
  color: var(--text-2);
  font-size: 26rpx;
  flex: none;
}

.chevron {
  color: var(--text-2);
  font-size: 34rpx;
  line-height: 1;
}

.lib-text {
  margin-top: 8rpx;
}

.lib-text__body {
  font-size: 30rpx;
  line-height: 1.9;
  color: var(--text);
  white-space: pre-wrap;
}

.lib-import {
  margin: 40rpx 0 24rpx;
}

.loading {
  text-align: center;
  padding: 32rpx 0;
}

.dialog {
  position: fixed;
  left: 60rpx;
  right: 60rpx;
  top: 50%;
  transform: translateY(-50%);
  z-index: 101;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.dialog__body {
  line-height: 1.6;
  white-space: pre-wrap;
}