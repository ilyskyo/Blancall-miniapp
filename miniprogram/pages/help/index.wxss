/* 帮助页：折叠分区 + 常见问题 */

.sections {
  margin-bottom: 36rpx;
}

.section + .section {
  border-top: 1rpx solid var(--border);
}

.section__head {
  border-bottom: none;
}

.section__icon {
  font-size: 34rpx;
  line-height: 1;
}

.section__arrow {
  color: var(--text-2);
  font-size: 26rpx;
}

.section__body {
  padding: 0 28rpx 24rpx;
}

.section__item {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
  margin-bottom: 12rpx;
}

.section__dot {
  color: var(--accent);
  line-height: 1.5;
}

.section__action {
  margin-top: 12rpx;
}

.faq-title {
  margin: 8rpx 0 16rpx;
}

.faq {
  padding: 24rpx 28rpx;
  border-bottom: 1rpx solid var(--border);
}

.faq:last-child {
  border-bottom: none;
}

.faq__q {
  font-weight: 600;
  margin-bottom: 8rpx;
}

.faq__a {
  line-height: 1.6;
}

.foot-btn {
  margin: 36rpx 0 40rpx;
}