/* 「我的文章」：筛选栏 + 文章列表 + 批量操作 + 编辑弹窗 */

.nav-actions {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.nav-action {
  padding: 4rpx 14rpx;
  font-size: 26rpx;
  color: var(--accent);
}

.filters {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.tagbar {
  width: 100%;
  white-space: nowrap;
  margin-bottom: 8rpx;
}

.tagbar__inner {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.count-line {
  margin: 16rpx 0 12rpx;
}

.article-row {
  align-items: flex-start;
  gap: 16rpx;
}

.article-row__main {
  min-width: 0;
}

.article-row__title {
  font-weight: 600;
}

.article-row__excerpt {
  margin: 10rpx 0 14rpx;
  line-height: 1.5;
}

.article-row__meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
}

.article-row__more {
  flex: none;
  padding: 8rpx 12rpx;
  color: var(--text-2);
  font-size: 34rpx;
  line-height: 1;
}

.check {
  flex: none;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  border: 2rpx solid var(--border);
  color: transparent;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 6rpx;
}

.check--on {
  background: var(--accent);
  border-color: transparent;
  color: var(--on-accent);
}

/* ---------- 批量操作栏 ---------- */

.bulk {
  position: fixed;
  left: 0;
  right: 0;
  bottom: calc(150rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin: 0 32rpx;
  padding: 20rpx 28rpx;
  border-radius: 28rpx;
  background: var(--glass-bg);
  border: 1rpx solid var(--glass-border);
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.16);
  backdrop-filter: blur(24rpx);
  -webkit-backdrop-filter: blur(24rpx);
  z-index: 60;
}

/* ---------- 编辑弹窗 ---------- */

.field {
  margin-bottom: 24rpx;
}

.field__input {
  margin-top: 10rpx;
  height: 84rpx;
  padding: 0 24rpx;
  border-radius: 20rpx;
  background: var(--bg-elev);
  border: 1rpx solid var(--border);
  color: var(--text);
  font-size: 30rpx;
}

.sheet__actions {
  margin-top: 12rpx;
}