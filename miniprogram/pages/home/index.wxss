/* 首页：品牌栏 + 搜索栏 + 卡片画布 + 添加卡片面板 */

/* ---------- 品牌栏 ---------- */

.brand {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 8rpx 32rpx 16rpx;
  background: var(--bg);
}

.brand__text {
  min-width: 0;
}

.brand__side {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.brand__chevron {
  color: var(--text-2);
  font-size: 26rpx;
  padding: 0 8rpx;
}

.brand--open {
  padding-bottom: 20rpx;
}

/* ---------- 搜索栏 ---------- */

.searchbar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  height: 76rpx;
  padding: 0 10rpx 0 26rpx;
  border-radius: 999rpx;
  background: var(--bg-elev);
  border: 1rpx solid var(--border);
  margin-bottom: 24rpx;
}

.searchbar__icon {
  font-size: 28rpx;
}

.searchbar__ph {
  flex: 1;
  min-width: 0;
}

.searchbar__add {
  flex: none;
  height: 56rpx;
  padding: 0 24rpx;
}

/* ---------- 空状态（偏下显示） ---------- */

.empty-wrap {
  margin-top: 160rpx;
}

/* ---------- 卡片画布 ---------- */

.cards {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.home-card {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  padding: 24rpx;
  min-height: 180rpx;
}

.home-card--wide {
  grid-column: span 2;
}

.home-card__head {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.home-card__title {
  font-weight: 600;
}

.home-card__pin {
  font-size: 24rpx;
  flex: none;
}

.home-card__lock {
  position: static;
  height: 36rpx;
  font-size: 20rpx;
  padding: 0 12rpx;
  background: var(--accent-soft);
  color: var(--accent);
}

.home-card__empty {
  line-height: 1.5;
}

.home-card__foot {
  margin-top: auto;
}

/* ---------- 列表型卡片行 ---------- */

.home-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 14rpx 0;
}

.home-row + .home-row {
  border-top: 1rpx solid var(--border);
}

.home-row__main {
  min-width: 0;
}

/* ---------- 每日一句 ---------- */

.sentence__text {
  font-size: 32rpx;
  line-height: 1.7;
  color: var(--text);
}

.sentence__src {
  text-align: right;
}

/* ---------- 导入入口卡片 ---------- */

.add-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  padding: 28rpx 0;
  text-align: center;
}

.add-card__icon {
  font-size: 56rpx;
  line-height: 1;
  color: var(--accent);
}

/* ---------- 统计卡片 ---------- */

.metrics {
  display: flex;
  align-items: flex-end;
  gap: 12rpx;
  margin-top: 8rpx;
}

.metric {
  flex: 1;
  min-width: 0;
  text-align: center;
}

.metric__value {
  font-size: 38rpx;
  font-weight: 700;
  color: var(--text);
}

/* ---------- 底部添加入口 ---------- */

.dock {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  margin-top: 36rpx;
}

.dock__hint {
  text-align: center;
}

/* ---------- 添加卡片面板 ---------- */

.sheet__empty {
  margin: 40rpx 0;
  text-align: center;
}

.type-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
  margin: 28rpx 0;
}

.type-cell {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 26rpx 8rpx;
  border-radius: 24rpx;
  background: var(--bg-elev);
  border: 1rpx solid var(--border);
  text-align: center;
}

.type-cell__icon {
  font-size: 40rpx;
  line-height: 1;
}

.sheet__close {
  margin-top: 8rpx;
}