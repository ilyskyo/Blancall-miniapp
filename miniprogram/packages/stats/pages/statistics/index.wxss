/* 单篇统计样式（颜色一律走 CSS 变量） */

.stats-body {
  padding-bottom: calc(80rpx + env(safe-area-inset-bottom));
}

.article-title {
  margin: 24rpx 4rpx 20rpx;
}

.group__title {
  font-size: 26rpx;
  color: var(--text-2);
  font-weight: 600;
  margin: 36rpx 8rpx 16rpx;
}

.chevron {
  color: var(--text-2);
  font-size: 30rpx;
  line-height: 1;
}

/* 总览网格 */
.overview-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.overview-cell {
  width: calc(33.33% - 14rpx);
  padding: 24rpx 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

.overview-value {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--accent);
  text-align: center;
  word-break: break-all;
}

/* 趋势 */
.trend {
  display: flex;
  align-items: flex-end;
  gap: 6rpx;
}

.trend__col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.trend__bar-wrap {
  width: 100%;
  height: 180rpx;
  display: flex;
  align-items: flex-end;
}

.trend__bar {
  width: 100%;
  min-height: 0;
  border-radius: 8rpx 8rpx 0 0;
  background: var(--accent);
  transition: height 0.3s ease;
}

.trend__label {
  font-size: 18rpx;
  color: var(--text-2);
  transform: scale(0.9);
}

/* 模式对比 */
.mode-row {
  padding: 14rpx 0;
  border-bottom: 1rpx solid var(--border);
}

.mode-row:last-child {
  border-bottom: none;
}

.mode-bar {
  margin-top: 12rpx;
}

/* 薄弱环节 */
.weakness-wrap {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.weakness-chip {
  display: flex;
  flex-direction: column;
  padding: 16rpx 24rpx;
  border-radius: 20rpx;
  background: var(--bg-elev);
  border: 1rpx solid var(--border);
  gap: 4rpx;
}

.weakness-label {
  font-size: 28rpx;
  font-weight: 600;
}

.weakness-count {
  font-size: 22rpx;
  color: var(--text-2);
}

/* 热力图 */
.heat-overall {
  margin-bottom: 12rpx;
}

.legend {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-bottom: 18rpx;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.legend-dot {
  width: 24rpx;
  height: 24rpx;
  border-radius: 6rpx;
}

.legend-dot--none {
  background: transparent;
  border: 1rpx solid var(--border);
}

.heat-wrap {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.heat-cell {
  position: relative;
  padding: 8rpx 14rpx;
  border-radius: 12rpx;
  border: 1rpx solid transparent;
  color: var(--on-accent);
}

.heat-cell--none {
  color: var(--text-2);
  border-color: var(--border);
}

.heat-cell__text {
  font-size: 26rpx;
}

.heat-cell__pct {
  font-size: 18rpx;
  opacity: 0.85;
  margin-left: 8rpx;
}

/* 练习历史 */
.history-item {
  border-bottom: 1rpx solid var(--border);
}

.history-item:last-child {
  border-bottom: none;
}

.history-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 24rpx 28rpx;
}

.history-detail {
  padding: 0 28rpx 24rpx;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.mistake-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.mistake-idx {
  width: 64rpx;
}

.mistake-wrong {
  color: var(--danger);
}

.mistake-right {
  color: var(--success);
}

.mistake-tag {
  margin-left: auto;
}

/* 分段控件 */
.seg {
  display: flex;
  background: var(--bg-elev);
  border: 1rpx solid var(--border);
  border-radius: 999rpx;
  padding: 6rpx;
  margin: 0 0 20rpx;
}

.seg__item {
  flex: 1;
  text-align: center;
  height: 68rpx;
  line-height: 68rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: var(--text-2);
  transition: background 0.18s ease, color 0.18s ease;
}

.seg__item--active {
  background: var(--accent);
  color: var(--on-accent);
  font-weight: 600;
}