.ctx-card {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-bottom: 16rpx;
}

.lock-banner {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-bottom: 16rpx;
  align-items: flex-start;
}

.msgs {
  height: calc(100vh - 420rpx);
  padding-bottom: 24rpx;
}

.msg {
  margin-bottom: 24rpx;
}

.bubble {
  display: inline-block;
  max-width: 88%;
  padding: 20rpx 24rpx;
  border-radius: 24rpx;
  font-size: 30rpx;
  line-height: 1.7;
  word-break: break-word;
}

.bubble--user {
  background: var(--accent);
  color: var(--on-accent);
  margin-left: 12%;
}

.bubble--ai {
  background: var(--bg-elev);
  border: 1rpx solid var(--border);
  color: var(--text);
}

.bubble--ai {
  display: block;
  margin-right: 12%;
}

.ai-label {
  margin-top: 8rpx;
}

.resend {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: var(--danger);
}

.input-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));
  background: var(--bg);
  border-top: 1rpx solid var(--border);
  z-index: 50;
}

.input-bar__field {
  flex: 1;
  height: 80rpx;
  padding: 0 24rpx;
  border-radius: 20rpx;
  background: var(--bg-elev);
  border: 1rpx solid var(--border);
  color: var(--text);
}

.tb-off {
  opacity: 0.45;
}

.picker {
  max-height: 520rpx;
  margin-bottom: 24rpx;
}

.picker-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-height: 88rpx;
  padding: 12rpx 8rpx;
  border-bottom: 1rpx solid var(--border);
}

.picker-check {
  width: 44rpx;
  height: 44rpx;
  border-radius: 12rpx;
  border: 1rpx solid var(--border);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: var(--on-accent);
  flex: none;
}

.picker-check--on {
  background: var(--accent);
  border-color: transparent;
}

.sheet-actions {
  display: flex;
  gap: 16rpx;
}