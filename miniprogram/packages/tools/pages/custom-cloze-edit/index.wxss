.name-card {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-bottom: 20rpx;
}

.editor-input {
  height: 80rpx;
  padding: 0 20rpx;
  border-radius: 18rpx;
  background: var(--bg-elev);
  border: 1rpx solid var(--border);
  color: var(--text);
}

.lock-banner {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-bottom: 20rpx;
  align-items: flex-start;
}

.content {
  height: calc(100vh - 520rpx);
  padding: 8rpx 4rpx;
}

.sentence {
  margin-bottom: 22rpx;
  line-height: 2.2;
  font-size: 32rpx;
}

.char {
  display: inline-block;
  min-width: 8rpx;
  padding: 0 2rpx;
  border-radius: 6rpx;
}

.char--blank {
  background: var(--accent);
  color: transparent;
}

.char--sel {
  background: var(--accent-soft);
  box-shadow: inset 0 0 0 2rpx var(--accent);
}

.toolbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  background: var(--bg);
  border-top: 1rpx solid var(--border);
  z-index: 50;
}

.toolbar__info {
  font-size: 24rpx;
  color: var(--text-2);
  margin-bottom: 12rpx;
}

.toolbar__btns {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}

.tb-btn {
  flex: 1;
  min-width: 120rpx;
  height: 76rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 27rpx;
  color: var(--text);
  background: var(--bg-elev);
  border: 1rpx solid var(--border);
}

.tb-btn--primary {
  background: var(--accent);
  border-color: transparent;
  color: var(--on-accent);
}

.tb-btn--off {
  opacity: 0.35;
}