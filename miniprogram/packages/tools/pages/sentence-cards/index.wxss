.card-main {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-bottom: 32rpx;
  padding: 48rpx 40rpx;
}

.quote {
  font-size: 40rpx;
  font-weight: 600;
  line-height: 1.9;
  letter-spacing: 0.5rpx;
}

.source {
  text-align: right;
}

.actions {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.share-canvas {
  position: fixed;
  left: -9999rpx;
  top: 0;
  width: 1080px;
  height: 1440px;
}