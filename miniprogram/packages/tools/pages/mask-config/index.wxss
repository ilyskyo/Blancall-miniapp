.head-card {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-bottom: 24rpx;
}

.lock-banner {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-bottom: 24rpx;
  align-items: flex-start;
}

.cfg-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx 24rpx;
  border-bottom: 1rpx solid var(--border);
}

.cfg-row:last-child {
  border-bottom: none;
}

.cfg-actions {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.icon-btn {
  min-width: 64rpx;
  height: 56rpx;
  padding: 0 16rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: var(--text-2);
  background: var(--bg-elev);
  border: 1rpx solid var(--border);
}

.icon-btn--danger {
  color: var(--danger);
}