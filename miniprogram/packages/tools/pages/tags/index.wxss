.lock-banner {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-bottom: 24rpx;
  align-items: flex-start;
}

.tag-list {
  margin-bottom: 16rpx;
}

.tag-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  min-height: 108rpx;
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid var(--border);
}

.tag-row:last-child {
  border-bottom: none;
}

.tag-row__dot {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  flex: none;
}

.tag-actions {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.icon-btn {
  min-width: 64rpx;
  height: 56rpx;
  padding: 0 16rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: var(--text-2);
  background: var(--bg-elev);
  border: 1rpx solid var(--border);
}

.icon-btn--danger {
  color: var(--danger);
}

.icon-btn--off {
  opacity: 0.3;
}

.tag-hint {
  padding: 8rpx 4rpx;
  line-height: 1.6;
}

.editor-input {
  height: 88rpx;
  padding: 0 24rpx;
  border-radius: 20rpx;
  background: var(--bg-elev);
  border: 1rpx solid var(--border);
  color: var(--text);
  margin-bottom: 24rpx;
}

.editor-label {
  margin-bottom: 16rpx;
}

.palette {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-bottom: 32rpx;
}

.palette__item {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  border: 4rpx solid transparent;
}

.palette__item--on {
  border-color: var(--text);
}

.sheet-actions {
  display: flex;
  gap: 16rpx;
}