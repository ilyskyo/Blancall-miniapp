.head-card {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.editor-input {
  height: 80rpx;
  padding: 0 20rpx;
  border-radius: 18rpx;
  background: var(--bg-elev);
  border: 1rpx solid var(--border);
  color: var(--text);
}

.lock-banner {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-bottom: 20rpx;
  align-items: flex-start;
}

.para-list {
  max-height: 420rpx;
  margin-top: 16rpx;
}

.para-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx 16rpx;
  border-radius: 16rpx;
  border: 1rpx solid var(--border);
  margin-bottom: 12rpx;
}

.para-row--on {
  border-color: var(--accent);
  background: var(--accent-soft);
}

.para-row__no {
  font-size: 24rpx;
  color: var(--text-2);
  flex: none;
}

.para-row__text {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
}

.palette {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin: 16rpx 0;
}

.palette__item {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  border: 4rpx solid transparent;
}

.palette__item--on {
  border-color: var(--text);
}

.edit-text,
.preview {
  line-height: 2.2;
  font-size: 32rpx;
  margin-top: 8rpx;
}

.char {
  display: inline-block;
  min-width: 8rpx;
  padding: 0 2rpx;
  border-radius: 6rpx;
}

.char--sel {
  box-shadow: inset 0 0 0 2rpx var(--accent);
}

.seg {
  display: inline-block;
  border-radius: 8rpx;
  padding: 0 2rpx;
}

.seg--revealed {
  color: var(--text);
  box-shadow: inset 0 -2rpx 0 var(--accent);
}

.toolbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  background: var(--bg);
  border-top: 1rpx solid var(--border);
  z-index: 50;
}

.toolbar__info {
  font-size: 24rpx;
  color: var(--text-2);
  margin-bottom: 12rpx;
}

.toolbar__btns {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}

.tb-btn {
  flex: 1;
  min-width: 140rpx;
  height: 76rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 27rpx;
  color: var(--text);
  background: var(--bg-elev);
  border: 1rpx solid var(--border);
}

.tb-btn--primary {
  background: var(--accent);
  border-color: transparent;
  color: var(--on-accent);
}

.tb-btn--off {
  opacity: 0.35;
}