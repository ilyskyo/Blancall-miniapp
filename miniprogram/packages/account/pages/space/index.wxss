/* 我的空间样式（颜色一律走 CSS 变量） */

.space-body {
  padding-bottom: calc(80rpx + env(safe-area-inset-bottom));
}

.group__title {
  font-size: 26rpx;
  color: var(--text-2);
  font-weight: 600;
  margin: 36rpx 8rpx 16rpx;
}

.usage-card {
  margin-top: 24rpx;
}

.usage-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.usage-used {
  font-size: 44rpx;
  font-weight: 700;
}

.usage-total {
  font-size: 26rpx;
  font-weight: 400;
  color: var(--text-2);
}

.usage-percent {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--accent);
}

.usage-progress {
  margin: 20rpx 0;
}

.usage-rows {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.usage-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.usage-value {
  font-size: 26rpx;
}

.expand-desc {
  margin-top: 10rpx;
  line-height: 1.5;
}

.expand-row {
  margin-top: 20rpx;
}

.picker-chip {
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  background: var(--bg-elev);
  border: 1rpx solid var(--border);
  font-size: 26rpx;
}

.ios-tip {
  margin-top: 16rpx;
  line-height: 1.5;
}

.bottom-note {
  text-align: center;
  margin-top: 40rpx;
  color: var(--accent);
}