# =============================================================================
# Blancall 小程序后端 环境变量示例
# 复制为 .env 后按需修改。所有键均可留空（留空即自动降级，见各项注释）。
# =============================================================================

# ---------- 基础 ----------
# 运行环境：development | production
NODE_ENV=development
# HTTP 监听端口
PORT=3000
# 对外可访问的基础地址（用于拼接本地存储的签名下载 URL、支付回调等）
# 生产必须是已备案的 HTTPS 域名，例如 https://api.example.com
PUBLIC_BASE_URL=http://localhost:3000

# ---------- 数据库（PostgreSQL） ----------
# Prisma 连接串
DATABASE_URL=postgresql://blancall:blancall@localhost:5432/blancall?schema=public

# ---------- 会话 ----------
# 会话 token 有效期（天）
SESSION_TTL_DAYS=30

# ---------- 管理员 ----------
# 管理员令牌，用于 /orders/:id/refund 等运维接口（请求头 X-Admin-Token 或 Bearer）
# 留空则禁用运维接口
ADMIN_TOKEN=

# ---------- 对象存储 ----------
# 驱动：local（磁盘 + 签名 URL，默认开发用）| s3（S3 兼容：COS/OSS/MinIO）
STORAGE_DRIVER=local
# local 驱动的落盘目录
STORAGE_LOCAL_DIR=./.data/storage
# local 驱动签名 URL 的 HMAC 密钥（生产必须改成随机长字符串）
STORAGE_URL_SECRET=please-change-me-to-a-long-random-string
# 签名 URL 有效期（秒），规范要求 ≤600
STORAGE_SIGNED_URL_TTL_SEC=600

# s3 驱动配置（STORAGE_DRIVER=s3 时生效）
S3_ENDPOINT=https://cos.ap-guangzhou.myqcloud.com
S3_REGION=ap-guangzhou
S3_BUCKET=blancall
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# MinIO / 部分自建网关需要 path-style 寻址
S3_FORCE_PATH_STYLE=true

# ---------- 微信登录 ----------
# 小程序 AppID / AppSecret；留空则自动进入 DEV_LOGIN 模式
WX_APPID=
WX_SECRET=
# 强制开发登录（用 code 生成稳定的 mock openid，如 dev_<sha1(code)>）
# 缺省：WX_APPID 为空时自动视为 true
DEV_LOGIN=

# ---------- 微信内容安全 ----------
# 是否启用 msgSecCheck；缺省：WX_APPID/WX_SECRET 齐全时自动为 true
# 生产必须启用（未启用时接口响应会带 securitySkipped: true）
WX_SECURITY_ENABLED=
# 送检场景值（1 资料 2 评论 3 论坛 4 社交日志），默认 2
WX_SECURITY_SCENE=2

# ---------- 微信订阅消息（学习提醒） ----------
# 学习提醒模板 ID：需在微信公众平台「订阅消息」中申请（一次性订阅）。
# 留空则定时任务直接跳过发送并打 warn 日志（开发环境不会报错）。
# 注意：模板字段（thing1/number2/date3/thing4 等）必须与本项目代码中的占位键对齐，
#       或申请后按实际模板字段调整 src/reminder/reminder.service.ts 中的 data 组装。
WX_SUBSCRIBE_TEMPLATE_ID=

# ---------- 微信支付 v3（JSAPI） ----------
# 开发模式：创建订单即视为已支付并立即发放权益（仅供内测，生产必须 false）
PAYMENT_DEV_MODE=true
# 商户号
WX_PAY_MCHID=
# 商户 API 证书序列号
WX_PAY_SERIAL_NO=
# 商户 API 私钥（PEM 内容，可用 \n 转义换行）；也可用下方 PATH 指定文件
WX_PAY_PRIVATE_KEY=
WX_PAY_PRIVATE_KEY_PATH=
# APIv3 密钥（32 位）
WX_PAY_APIV3_KEY=
# 微信支付平台证书（PEM 内容或 PATH）；用于回调验签
WX_PAY_PLATFORM_CERT=
WX_PAY_PLATFORM_CERT_PATH=
# 支付回调地址（必须是 HTTPS 备案域名 + 公网可达）
WX_PAY_NOTIFY_URL=https://api.example.com/api/v1/pay/notify

# ---------- AI（OpenAI 兼容接口） ----------
# 示例（DeepSeek）：AI_BASE_URL=https://api.deepseek.com/v1  AI_MODEL=deepseek-chat
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
# 上游超时（毫秒），规范建议挖空 40s
AI_TIMEOUT_MS=40000
# 平台级日预算熔断：每日全平台最多消耗的 AI 卡数（0 或留空 = 不限制）
# 使用 ai_daily_usage 表按自然日（Asia/Shanghai）原子累加；超出后 AI 接口返回 AI_BUDGET_EXCEEDED
AI_DAILY_BUDGET_CARDS=0

# ---------- 限时免费活动（运营开关） ----------
# 打开后：5 个单项付费功能 + AI（不扣卡）在活动期内免费使用；购买/充值链路不受影响
# 前端所有付费功能入口会显示灰色小按键「点此限时免费使用」
FREE_CAMPAIGN_ENABLED=true
# 覆盖范围：* = 全部付费功能 + AI；也可写子集，如 pdf_import,ai
FREE_CAMPAIGN_FEATURES=*
# 结束时间（ISO 时间，留空 = 不限）；到点自动失效，无需发版
FREE_CAMPAIGN_ENDS_AT=
# 提示：活动覆盖 AI 时建议同时设置 AI_DAILY_BUDGET_CARDS（否则上游成本不受控）

# ---------- 素材库（gaokao 文本） ----------
# 正文目录；生产可挂载只读卷，缺省使用 server/assets/gaokao
GAOKAO_ASSETS_DIR=

# ---------- 导出 ----------
# 导出文件签名 URL 有效期（秒）
EXPORT_TTL_SEC=600

# ---------- 定时任务 ----------
# 排行榜快照生成（默认每日 03:00，Asia/Shanghai）
LEADERBOARD_CRON=0 3 * * *
# 定时任务时区
TZ=Asia/Shanghai